+use rndr_core::*;
+use rndr_ui::{controls::*, *};
+#[test]
+fn nested_source_focus_real_glyph_clip_and_hit_geometry_agree() {
+    let mut a = App::new();
+    a.add_plugin(UiPlugin);
+    let outer = a.world_mut().spawn((
+        Layout {
+            width: Size::Px(300.0),
+            height: Size::Px(140.0),
+            ..Layout::column()
+        },
