+    def test_concurrent_publishers_return_one_consistent_pair(self):
+        barrier = threading.Barrier(2)
+        outcomes = []
+        def publish(value):
+            barrier.wait()
+            try:
+                client.save_frame(self.prefix, {"owner": value}, value.encode())
