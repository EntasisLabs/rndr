+        let recv = request(&send, 0);
+        let (_, capture) = rndr_paint::frame_with_snapshot(&mut app, |w| begin(w, 2, 2, 1.));
+        assert!(original.shape_count() > 0);
+        assert!(!Arc::ptr_eq(&original, &text_engine(app.world())));
